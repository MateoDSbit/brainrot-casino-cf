{
  // Configuration Cloudflare du Brainrot Casino
  "name": "brainrot-casino",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "CASINO", "class_name": "Casino" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Casino"] }],
  "observability": { "enabled": true }
}
